generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Photo {
  id         Int    @id @default(autoincrement())
  slug       String @unique
  src        String
  title      String
  location   String
  blurImgUrl String @map("blurimgurl")

  likes    Like[]
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("photos")
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique

  comments Comment[]

  createdAt DateTime @default(now())

  @@map("users")
}

model Like {
  id Int @id @default(autoincrement())

  photoId      Int
  visitorToken String

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([photoId, visitorToken])
  @@index([photoId])
  @@map("likes")
}

model Comment {
  id      Int    @id @default(autoincrement())
  content String

  photoId Int
  userId  Int

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([photoId, createdAt])
  @@index([userId])
  @@map("comments")
}
